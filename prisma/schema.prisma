generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(uuid())
  username            String               @unique
  password            String
  role                String               @default("STUDENT")
  name                String
  profilePic          String?
  grade               String?
  groupName           String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  passwordPlain       String?
  googleAccessToken   String?
  googleDriveFolderId String?
  googleRefreshToken  String?
  googleTokenExpiry   DateTime?
  groupId             String?
  coursesAsTeacher    Course[]             @relation("TeacherCourses")
  googleDriveAccounts GoogleDriveAccount[]
  submissions         Submission[]
  group               GradeGroup?          @relation("GroupStudents", fields: [groupId], references: [id])

  @@index([groupId])
  @@index([role])
}

model Course {
  id            String       @id @default(uuid())
  name          String
  description   String?
  teacherId     String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  period1Active Boolean      @default(true)
  period2Active Boolean      @default(true)
  period3Active Boolean      @default(true)
  period4Active Boolean      @default(true)
  teacher       User         @relation("TeacherCourses", fields: [teacherId], references: [id], onDelete: Cascade)
  resources     Resource[]
  tasks         Task[]
  groups        GradeGroup[] @relation("GroupCourses")

  @@index([teacherId])
}

model Resource {
  id          String       @id @default(uuid())
  title       String
  type        String
  url         String
  courseId    String
  createdAt   DateTime     @default(now())
  period      String?
  theme       String?
  active      Boolean      @default(true)
  publishAt   DateTime?
  gdriveEmail String?
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  groups      GradeGroup[] @relation("GroupResources")

  @@index([courseId])
  @@index([active])
}

model Task {
  id                  String       @id @default(uuid())
  title               String
  description         String?
  dueDate             DateTime
  courseId            String
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  attachmentUrl       String?
  period              String?
  theme               String?
  weight              Int          @default(0)
  active              Boolean      @default(true)
  allowLateSubmission Boolean      @default(false)
  lateSubmissionUntil DateTime?
  publishAt           DateTime?
  gdriveEmail         String?
  type                String       @default("TASK")
  duration            Int?
  submissions         Submission[]
  course              Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  groups              GradeGroup[] @relation("GroupTasks")

  @@index([courseId])
  @@index([active])
}

model Submission {
  id                  String    @id @default(uuid())
  taskId              String
  studentId           String
  status              String    @default("PENDING")
  grade               Float?
  feedback            String?
  fileUrl             String?
  submittedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  allowLateSubmission Boolean   @default(false)
  lateSubmissionUntil DateTime?
  gdriveEmail         String?
  startedAt           DateTime?
  student             User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  task                Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, studentId])
  @@index([studentId])
  @@index([taskId])
}

model Grade {
  id        String       @id @default(uuid())
  name      String       @unique
  createdAt DateTime     @default(now())
  groups    GradeGroup[]
}

model GradeGroup {
  id        String     @id @default(uuid())
  name      String
  gradeId   String
  createdAt DateTime   @default(now())
  grade     Grade      @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  students  User[]     @relation("GroupStudents")
  courses   Course[]   @relation("GroupCourses")
  resources Resource[] @relation("GroupResources")
  tasks     Task[]     @relation("GroupTasks")

  @@unique([gradeId, name])
  @@index([gradeId])
}

model Period {
  id        String   @id @default(uuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GoogleDriveAccount {
  id                  String   @id @default(uuid())
  userId              String
  email               String
  googleAccessToken   String
  googleRefreshToken  String
  googleTokenExpiry   DateTime
  googleDriveFolderId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  customLimit         Float?
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, email])
  @@index([userId])
}

model DriveUploadQueue {
  id            String    @id @default(uuid())
  recordType    String
  recordId      String
  supabaseUrl   String
  supabasePath  String
  teacherId     String
  filename      String
  mimeType      String
  folderPath    String
  attempts      Int       @default(0)
  lastAttemptAt DateTime?
  createdAt     DateTime  @default(now())

  @@index([teacherId])
  @@index([recordType, recordId])
}
