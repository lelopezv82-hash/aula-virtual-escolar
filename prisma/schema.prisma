generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(uuid())
  username            String               @unique
  password            String
  role                String               @default("STUDENT")
  name                String
  profilePic          String?
  grade               String?
  groupName           String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  passwordPlain       String?
  googleAccessToken   String?
  googleDriveFolderId String?
  googleRefreshToken  String?
  googleTokenExpiry   DateTime?
  groupId             String?
  mustChangePassword  Boolean              @default(true)
  additionalGrades    AdditionalGrade[]
  coursesAsTeacher    Course[]             @relation("TeacherCourses")
  googleDriveAccounts GoogleDriveAccount[]
  submissions         Submission[]
  group               GradeGroup?          @relation("GroupStudents", fields: [groupId], references: [id])
  securityQuestion      String?
  securityAnswer        String?
  securityPin           String?
  recoveryEmail         String?
  resetRequests         PasswordResetRequest[]

  @@index([groupId])
  @@index([role])
}

model PasswordResetRequest {
  id        String   @id @default(uuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([status])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  studentId String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([studentId])
}

model Course {
  id               String            @id @default(uuid())
  name             String
  description      String?
  teacherId        String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  period1Active    Boolean           @default(true)
  period2Active    Boolean           @default(true)
  period3Active    Boolean           @default(true)
  period4Active    Boolean           @default(true)
  active           Boolean           @default(true)
  hacerPercent     Int               @default(50)
  saberPercent     Int               @default(30)
  serPercent       Int               @default(20)
  finalPercent     Int               @default(0)
  gDriveSyncFiles  Json?
  planillaData     Json?
  hiddenSections   Json?
  additionalGrades AdditionalGrade[]
  teacher          User              @relation("TeacherCourses", fields: [teacherId], references: [id], onDelete: Cascade)
  resources        Resource[]
  tasks            Task[]
  themes           Theme[]
  groups           GradeGroup[]      @relation("GroupCourses")
  periodCourses    PeriodCourse[]

  @@index([teacherId])
}


model Resource {
  id          String       @id @default(uuid())
  title       String
  type        String
  url         String
  courseId    String
  createdAt   DateTime     @default(now())
  period      String?
  theme       String?
  active      Boolean      @default(true)
  publishAt   DateTime?
  gdriveEmail String?
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  groups      GradeGroup[] @relation("GroupResources")
  tasks       Task[]       @relation("TaskResources")
  themes      Theme[]      @relation("ThemeResources")

  @@index([courseId])
  @@index([active])
}

model Task {
  id                  String       @id @default(uuid())
  title               String
  description         String?
  dueDate             DateTime
  courseId            String
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  attachmentUrl       String?
  period              String?
  theme               String?
  weight              Int          @default(0)
  active              Boolean      @default(true)
  allowLateSubmission Boolean      @default(false)
  lateSubmissionUntil DateTime?
  publishAt           DateTime?
  gdriveEmail         String?
  type                String       @default("TASK")
  duration            Int?
  isExternal          Boolean      @default(false)
  questions           Question[]
  submissions         Submission[]
  course              Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  groups              GradeGroup[] @relation("GroupTasks")
  resources           Resource[]   @relation("TaskResources")
  themes              Theme[]      @relation("ThemeTasks")

  @@index([courseId])
  @@index([active])
}

model Submission {
  id                  String    @id @default(uuid())
  taskId              String
  studentId           String
  status              String    @default("PENDING")
  grade               Float?
  feedback            String?
  fileUrl             String?
  submittedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  allowLateSubmission Boolean   @default(false)
  lateSubmissionUntil DateTime?
  gdriveEmail         String?
  startedAt           DateTime?
  attempt             Int       @default(1)
  unlockedAnswers     Boolean   @default(false)
  answers             Json?
  student             User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  task                Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, studentId])
  @@index([studentId])
  @@index([taskId])
}

model Grade {
  id        String       @id @default(uuid())
  name      String       @unique
  createdAt DateTime     @default(now())
  groups    GradeGroup[]
}

model GradeGroup {
  id        String     @id @default(uuid())
  name      String
  gradeId   String
  createdAt DateTime   @default(now())
  grade     Grade      @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  students  User[]     @relation("GroupStudents")
  courses   Course[]   @relation("GroupCourses")
  resources Resource[] @relation("GroupResources")
  tasks     Task[]     @relation("GroupTasks")

  @@unique([gradeId, name])
  @@index([gradeId])
}

model Period {
  id           String         @id @default(uuid())
  name         String         @unique
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  periodCourses PeriodCourse[]
}

model PeriodCourse {
  id        String   @id @default(uuid())
  periodId  String
  courseId  String
  createdAt DateTime @default(now())
  period    Period   @relation(fields: [periodId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([periodId, courseId])
  @@index([periodId])
  @@index([courseId])
}

model Theme {
  id        String     @id @default(uuid())
  title     String
  courseId  String
  order     Int        @default(0)
  createdAt DateTime   @default(now())
  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  resources Resource[] @relation("ThemeResources")
  tasks     Task[]     @relation("ThemeTasks")

  @@index([courseId])
}

model GoogleDriveAccount {
  id                  String   @id @default(uuid())
  userId              String
  email               String
  googleAccessToken   String
  googleRefreshToken  String
  googleTokenExpiry   DateTime
  googleDriveFolderId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  customLimit         Float?
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, email])
  @@index([userId])
}

model DriveUploadQueue {
  id            String    @id @default(uuid())
  recordType    String
  recordId      String
  supabaseUrl   String
  supabasePath  String
  teacherId     String
  filename      String
  mimeType      String
  folderPath    String
  attempts      Int       @default(0)
  lastAttemptAt DateTime?
  createdAt     DateTime  @default(now())

  @@index([teacherId])
  @@index([recordType, recordId])
}

model Question {
  id        String   @id @default(uuid())
  taskId    String
  text      String
  type      String   @default("MULTIPLE_CHOICE")
  points    Float    @default(1.0)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  options   Option[]
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Option {
  id         String   @id @default(uuid())
  questionId String
  text       String
  isCorrect  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model AdditionalGrade {
  id        String   @id @default(uuid())
  studentId String
  courseId  String
  period    String
  grade     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId, period])
  @@index([studentId])
  @@index([courseId])
}
